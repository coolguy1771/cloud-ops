# UniFi directory sync / delegated auth. The outpost (ldap-home) runs on the home LAN,
# not in this cluster. Bind flow must stay ldap-authentication: the default flow's
# captcha stage breaks LDAP binds.
resource "authentik_provider_ldap" "unifi" {
  name             = "Provider for Unifi"
  base_dn          = "dc=ldap,dc=witl,dc=xyz"
  bind_flow        = authentik_flow.ldap_authentication.uuid
  unbind_flow      = data.authentik_flow.default_invalidation_flow.id
  bind_mode        = "cached"
  search_mode      = "cached"
  certificate      = data.authentik_certificate_key_pair.self_signed.id
  tls_server_name  = "10.2.30.217"
  mfa_support      = false
  uid_start_number = 2000
  gid_start_number = 4000
}
