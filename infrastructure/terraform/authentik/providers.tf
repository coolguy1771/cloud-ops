# OAuth2/OIDC and LDAP providers. client_id values are public identifiers; client
# secrets are generated by authentik and never stored here (they stay computed).

locals {
  oidc_scopes = [for s in ["openid", "email", "profile"] : data.authentik_property_mapping_provider_scope.oidc[s].id]
}

resource "authentik_provider_oauth2" "grafana" {
  name                  = "Grafana"
  client_id             = "ccIrxoIFzPkF9CmYHwgLnP6i18B4RS3k0wOOi03N"
  client_type           = "confidential"
  access_token_validity = "hours=1"
  authentication_flow   = authentik_flow.default_authentication_flow.uuid
  authorization_flow    = data.authentik_flow.default_provider_authorization_explicit_consent.id
  invalidation_flow     = data.authentik_flow.default_invalidation_flow.id
  signing_key           = data.authentik_certificate_key_pair.self_signed.id
  grant_types           = ["authorization_code", "refresh_token"]
  sub_mode              = "hashed_user_id"
  property_mappings = concat(local.oidc_scopes, [
    data.authentik_property_mapping_provider_scope.offline_access.id,
    authentik_property_mapping_provider_scope.observability_tenant_id.id,
  ])
  allowed_redirect_uris = [{
    matching_mode     = "strict"
    redirect_uri_type = "authorization"
    url               = "https://grafana.cloud.witl.xyz/login/generic_oauth"
  }]
}

