resource "authentik_provider_oauth2" "hermes" {
  name                    = "Provider for Hermes"
  client_id               = "G7uiMQaMKhCq6I5HDseBFkdgfc9lQFc8HNZlm9yu"
  client_type             = "public"
  authorization_flow      = data.authentik_flow.default_provider_authorization_implicit_consent.id
