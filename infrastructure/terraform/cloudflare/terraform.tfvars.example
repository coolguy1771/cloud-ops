# Copy to terraform.tfvars (gitignored). Prefer: export CLOUDFLARE_API_TOKEN=...
#
# Create a token at https://dash.cloudflare.com/profile/api-tokens with:
#   Zone Resources: Include → cloud.witl.xyz
#   Permissions:
#     Zone → Zone → Read
#     Zone → WAF → Edit
#     Account → Account Firewall Access Rules → Edit
# Store as 1Password cloudflare.waf-token (do not reuse dns-token).
#
# Zone custom security rules: one entry-point ruleset per zone. Discover + import:
#   export CLOUDFLARE_API_TOKEN=...
#   ./scripts/import-zone-custom-ruleset.sh
# That writes existing_custom_rules.auto.tfvars.json (ruleset id + extra rules).

# cloudflare_api_token  = "..."  # or CLOUDFLARE_API_TOKEN
cloudflare_zone_id    = "8674d30d5114d5526b93a694f9bffb57"
cloudflare_account_id = "d78593257a77725d26d210d4d91ca58a"
# zone_custom_firewall_ruleset_id = "..."  # from import script / dashboard
# authentik_host      = "auth.cloud.witl.xyz"
