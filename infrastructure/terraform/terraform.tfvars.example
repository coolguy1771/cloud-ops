# Copy to terraform.tfvars and fill in values.
# Never commit terraform.tfvars — it contains secrets.

hcloud_token = "your-hetzner-api-token"

# Hetzner snapshot ID of the Omni Talos image.
# Steps to get it:
#   1. Omni portal → Add Machine → Download Installation Media → Hetzner (amd64)
#   2. Upload via Packer or: hcloud-upload-image --architecture x86 --compression xz <image.raw.xz>
#   3. Note the resulting snapshot ID and set it here.
talos_image_id = "123456789"

cluster_name = "cloud-ops"

# Spread control planes across two locations for HA:
control_plane_locations   = ["fsn1", "nbg1", "fsn1"]
control_plane_server_type = "cx32"

# Workers are provisioned dynamically by the Hetzner Omni infra provider
# (see hetzner_infra_provider.tf) — these configure the MachineClasses it
# uses, not a static hcloud_server fleet. One MachineClass + one
# omni_machine_set is created per location below, each sized independently.
worker_server_type = "cx32"
worker_locations = {
  fsn1 = 4
  nbg1 = 2
  hel1 = 1
}
worker_allocation_type = "Static" # or "Unlimited" to autoscale to cluster demand (per location)

# --- Omni (cluster management via Terraform provider) ---
# Create a key: omnictl serviceaccount create --use-user-role=false <name>
omni_endpoint = "https://your-instance.omni.siderolabs.io"
# omni_service_account_key = "..."  # or export OMNI_SERVICE_ACCOUNT_KEY

kubernetes_version = "1.36.1"
talos_version      = "1.13.7"

# Control plane machines are discovered from Omni via omnictl labels (no
# machine classes) — workers are allocated dynamically instead, see above.
# Assign control plane nodes with: omnictl get clustermachines -l omni.sidero.dev/cluster=cloud-ops

# --- Hetzner Omni Infra Provider ---
# One-time manual step against your Omni instance (mints a credential, not
# automated by Terraform): omnictl infraprovider create hetzner
# Run the daemon (github.com/coolguy1771/hetzner-infra-provider) with the
# resulting key + your hcloud_token — it runs outside this repo.
hetzner_infra_provider_id = "hetzner"
