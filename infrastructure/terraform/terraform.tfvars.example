# Copy values into the HCP Terraform workspace variables (preferred) or a local
# terraform.tfvars for CLI use. Never commit terraform.tfvars — it contains secrets.
#
# HCP: org coolguy1771 / workspace cloud-ops (see versions.tf cloud block).
# Provider secrets belong in the workspace env: TF_VAR_hcloud_token,
# TF_VAR_omni_service_account_key, TF_VAR_omni_endpoint (or HCLOUD_TOKEN /
# OMNI_* equivalents supported by the providers).

# hcloud_token / omni_service_account_key: set in HCP workspace (sensitive)

# Hetzner snapshot ID of the Omni Talos image.
# Steps to get it:
#   1. Omni portal → Add Machine → Download Installation Media → Hetzner (amd64)
#   2. Upload via Packer or: hcloud-upload-image --architecture x86 --compression xz <image.raw.xz>
#   3. Note the resulting snapshot ID and set it here.
talos_image_id = "123456789"

cluster_name = "cloud-ops"

# Single region (fsn1) — all nodes consolidated to one Hetzner location.
# DB replication across regions (fsn1<->nbg1/hel1) caused poor performance;
# the tradeoff is no cross-region HA.
control_plane_locations = ["fsn1", "fsn1", "fsn1"]
# Uniform type, or use control_plane_server_types for rolling resize:
control_plane_server_type = "cx33"
# control_plane_server_types = ["cx33", "cx33", "cx33"]

# Required for HCP SaaS runs (no omnictl discovery). From:
#   omnictl get machinestatuses -o yaml
control_plane_machine_ids = [
  "00000000-0000-0000-0000-000000000001",
  "00000000-0000-0000-0000-000000000002",
  "00000000-0000-0000-0000-000000000003",
]

# fsn1 worker count is applied by Terraform (omni_machine_set.workers), backed
# by omni_machine_class.hetzner_workers_fsn1 (Terraform-managed as of provider
# v0.1.0-beta.0). Single-region consolidation removed the nbg1/hel1 sets.
worker_locations = {
  fsn1 = 7
}
worker_allocation_type = "Static" # or "Unlimited"
worker_server_type = "cx43" # Hetzner flavor for auto-provisioned workers

# Hetzner infra provider (omni_infra_provider.hetzner). Import the existing
# object before the first apply: terraform import omni_infra_provider.hetzner hetzner
hetzner_infra_provider_name = "hetzner"
hetzner_infra_provider_ttl  = "8760h" # 365d; renew by changing this or renew_trigger

# --- Omni ---
omni_endpoint = "https://your-instance.omni.siderolabs.io"

kubernetes_version = "1.36.1"
talos_version      = "1.13.7"
